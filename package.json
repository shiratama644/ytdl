{
  "name": "ytdl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun scripts/execute.ts",
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"bun run dev:server\" \"bun run dev:client\"",
    "dev:client": "vite",
    "dev:server": "bun --watch server/index.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "clsx": "^2.1.1",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "hono": "^4.13.7",
    "lucide-react": "^1.41.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "youtubei.js": "^13.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.1",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.5",
    "concurrently": "^9.2.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
