{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // globals: false（vitest.config.ts）に合わせ、vitest/globals は types に含めない。
    // テストは vitest を明示 import するため、ここでは jest-dom matcher と node 型のみ。
    "types": [
      "@testing-library/jest-dom",
      "node"
    ]
  },
  "include": [
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "vitest.setup.ts",
    "vitest.config.ts",
    "lib/**/*.ts",
    "components/**/*.ts",
    "components/**/*.tsx",
    "scripts/**/*.ts",
    "types/**/*.ts",
    "next-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
